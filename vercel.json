{
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/about/index.html", "destination": "/about", "permanent": true },
    { "source": "/contact/index.html", "destination": "/contact", "permanent": true },
    { "source": "/corte-de-pelo-hombre-vigo/index.html", "destination": "/corte-de-pelo-hombre-vigo", "permanent": true },
    { "source": "/arreglo-barba-vigo/index.html", "destination": "/arreglo-barba-vigo", "permanent": true },
    { "source": "/preguntas-frecuentes/index.html", "destination": "/preguntas-frecuentes", "permanent": true },
    { "source": "/privacy/index.html", "destination": "/privacy", "permanent": true },
    { "source": "/aviso-legal/index.html", "destination": "/aviso-legal", "permanent": true },
    { "source": "/tienda/index.html", "destination": "/tienda", "permanent": true },
    { "source": "/tienda/producto/:slug/index.html", "destination": "/tienda/producto/:slug", "permanent": true },
    { "source": "/tienda/gracias/index.html", "destination": "/tienda/gracias", "permanent": true },
    { "source": "/tienda/envios-devoluciones/index.html", "destination": "/tienda/envios-devoluciones", "permanent": true },
    { "source": "/tienda/condiciones/index.html", "destination": "/tienda/condiciones", "permanent": true },
    { "source": "/tienda/desistir/index.html", "destination": "/tienda/desistir", "permanent": true },
    { "source": "/blog/index.html", "destination": "/blog", "permanent": true },
    { "source": "/blog/:slug/index.html", "destination": "/blog/:slug", "permanent": true }
  ],
  "crons": [{ "path": "/api/brevo-keepalive", "schedule": "0 8 1 * *" }],
  "functions": {
    "api/checkout.mjs": { "includeFiles": "tienda/productos.json" },
    "api/desistimiento.mjs": { "includeFiles": "tools/tienda-templates/legal-textos.mjs" },
    "api/stripe-webhook.mjs": { "includeFiles": "{tienda/productos.json,tools/tienda-templates/legal-textos.mjs}" }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(styles.min.css|main.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/tienda/gracias",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
