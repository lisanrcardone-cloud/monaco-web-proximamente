{
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/about/index.html", "destination": "/about", "permanent": true },
    { "source": "/contact/index.html", "destination": "/contact", "permanent": true },
    { "source": "/privacy/index.html", "destination": "/privacy", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(styles.min.css|main.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Vary", "value": "Accept" }
      ]
    }
  ]
}
