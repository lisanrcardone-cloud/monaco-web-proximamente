{
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/about/index.html", "destination": "/about", "permanent": true },
    { "source": "/contact/index.html", "destination": "/contact", "permanent": true },
    { "source": "/privacy/index.html", "destination": "/privacy", "permanent": true },
    { "source": "/tienda/index.html", "destination": "/tienda", "permanent": true },
    { "source": "/tienda/producto/:slug/index.html", "destination": "/tienda/producto/:slug", "permanent": true },
    { "source": "/tienda/gracias/index.html", "destination": "/tienda/gracias", "permanent": true },
    { "source": "/tienda/envios-devoluciones/index.html", "destination": "/tienda/envios-devoluciones", "permanent": true },
    { "source": "/tienda/condiciones/index.html", "destination": "/tienda/condiciones", "permanent": true }
  ],
  "functions": {
    "api/checkout.mjs": { "includeFiles": "tienda/productos.json" }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(styles.min.css|main.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/tienda/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
